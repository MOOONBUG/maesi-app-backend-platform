# Copy to .env and fill in non-sensitive settings.
HOST=127.0.0.1
PORT=8000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_user
DB_NAME=your_database
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_MODEL=your_model

