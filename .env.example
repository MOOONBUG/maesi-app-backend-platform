# Copy this file to .env. Keep real secrets in .env.secrets.
HOST=127.0.0.1
PORT=8000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_user
DB_NAME=your_database
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_MODEL=your_model

# Secrets: fill these only in local .env.secrets; never commit them.
# DB_PASSWORD=change-me-locally
# OPENAI_API_KEY=replace-with-local-key
# OPENAI_API_KEYS=primary-key,backup-key
# BEARER_TOKEN=replace-with-local-token

GPUOPS_APP_NAME=MAESI APP 后端服务平台
GPU_SNAPSHOT_TIMEOUT=3
